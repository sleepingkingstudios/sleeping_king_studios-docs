---
plugins:
  - sleeping_king_studios/docs/jekyll/plugins/required
collections:
  classes:
    output: false
  constants:
    output: false
  methods:
    output: false
  modules:
    output: false
  namespaces:
    output: false
defaults:
- scope:
    path: ''
    type: 'pages'
  values:
    encoding: 'utf-8'
    layout: 'page'
    title: 'Cuprum::Cli'
exclude:
  - /vendor
markdown: kramdown

# Project Configuration
project_metadata:
  description:    '<%= project_description %>'
  name:           '<%= project_name %>'
  repository_url: '<%= project_repository %>'
  versions:       []
